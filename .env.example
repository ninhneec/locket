# Do not commit a real API key. Copy this file to .env.local.
JAYDEV_API_BASE_URL=https://locket.jayteam.click
JAYDEV_API_KEY=

# Supported values: x-api-key | bearer
JAYDEV_AUTH_MODE=x-api-key

# The two supplied documents describe different routes. Override these after
# confirming the contract with the API administrator.
JAYDEV_STATS_PATH=/api/v1/credits
JAYDEV_CUSTOMERS_PATH=/api/v1/ctv/customers
JAYDEV_ACTIVATE_PATH=/api/v1/dns/export
JAYDEV_LOOKUP_PATH=/api/v1/dns/lookup
PORT=8787

# Optional server-side key used by AI Image Lab for api.xah.io.
XAH_API_KEY=

# Optional overrides for config/telegram.local.json.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

